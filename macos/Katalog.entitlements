<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the App Store. Everything below re-opens exactly what the
	     sandbox takes away, and nothing more. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Importing epubs and choosing a library folder, both via NSOpenPanel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Reaching that library folder again on the next launch. See Bookmark in
	     LibraryStore.swift. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<!-- Send to Kindle: the device mounts as a USB volume and we write into its
	     documents/ folder. Without this /Volumes is invisible. -->
	<key>com.apple.security.files.removable-volumes.read-write</key>
	<true/>

	<!-- Online metadata lookup. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
